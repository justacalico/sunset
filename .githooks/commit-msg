#!/bin/sh
# Prefix non-conventional subjects with misc: so cog check stays clean.
msg="$1"
line=$(head -n1 "$msg" | tr -d '\r')
[ -z "$line" ] && exit 0
if echo "$line" | grep -qE '^(feat|fix|chore|ci|docs|refactor|style|test|perf|revert|build|misc)(\(.+\))?(!)?:'; then
  exit 0
fi
echo "misc: $line" > "$msg.tmp"
tail -n +2 "$msg" >> "$msg.tmp"
mv "$msg.tmp" "$msg"
